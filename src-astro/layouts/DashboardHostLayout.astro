---
import "../../src/index.css";
import "../../src/styles/fonts.css";
import {
  buildThemeModeBootstrapScript,
  getThemeModeDocumentAttributes,
} from "../../src/lib/theme-mode-bootstrap";
import type { SiteSettings } from "../../src/types/site-settings";

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title: _title = "Dashboard",
  description: _description = "Dashboard interno do Nekomorto.",
  robots: _robots = "noindex, nofollow",
} = Astro.props;
const locals = Astro.locals.nekomata;
const siteSettings = (locals?.siteSettings ?? {}) as Partial<SiteSettings>;
const siteName = String(siteSettings.site?.name || "Nekomata").trim() || "Nekomata";
const separator = siteSettings.site?.titleSeparator || " | ";
const pageTitle = _title ? `${_title}${separator}${siteName}` : siteName;
const themeModeDocument = getThemeModeDocumentAttributes(siteSettings);
const themeModeBootstrapScript = buildThemeModeBootstrapScript(siteSettings);
---

<!doctype html>
<html
  lang="pt-BR"
  data-global-theme-mode={themeModeDocument.mode}
  data-theme-accent={themeModeDocument.accent}
  data-theme-mode={themeModeDocument.mode}
  class={themeModeDocument.className}
  style={themeModeDocument.style}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={_description} />
    <meta name="robots" content={_robots} />
    <meta name="theme-color" content="hsl(var(--background))" />
    <script is:inline set:html={themeModeBootstrapScript} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <slot />
  </body>
</html>
